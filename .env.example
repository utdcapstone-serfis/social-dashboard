# ─────────────────────────────────────────────────────────────────────────────
# Social Command Center: server-side secrets.
#
#   cp .env.example .env.local     (never commit .env.local)
#
# These are read ONLY by the Node server in /server. Never prefix anything with
# VITE_ — Vite inlines VITE_* variables into the public browser bundle.
# A platform whose variables are blank is simply shown as "Not connected".
# If nothing is configured the UI shows labelled demo data.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
# Bind address. Keep 127.0.0.1 unless the server sits behind an authenticated
# reverse proxy; /api/metrics itself has no login.
HOST=127.0.0.1
# Where snapshots/history are cached (git-ignored).
DASHBOARD_CACHE_DIR=.cache
# Which day's numbers to report at the midnight refresh. 1 = "yesterday" (full day).
# Platform analytics often lag 24-48h; raise to 2 if yesterday reads low/zero.
REPORT_LAG_DAYS=1

# ── YouTube (Data API v3 + Analytics API v2) ─────────────────────────────────
# Daily views/likes/shares/retention need the Analytics API, which requires OAuth.
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_long_lived_refresh_token

# ── Meta Graph API: Instagram ────────────────────────────────────────────────
META_GRAPH_VERSION=v23.0
META_IG_USER_ID=your_instagram_business_account_id
META_ACCESS_TOKEN=your_long_lived_user_or_system_user_token

# ── Meta Graph API: Facebook Page ────────────────────────────────────────────
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token

# ── TikTok (Display API) ─────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
# Obtained once via the OAuth flow (scopes: user.info.basic, video.list). The server
# stores any rotated token under DASHBOARD_CACHE_DIR after the first refresh.
TIKTOK_REFRESH_TOKEN=your_tiktok_refresh_token

# ── X / Twitter (API v2) ─────────────────────────────────────────────────────
X_BEARER_TOKEN=your_x_bearer_token
X_USER_ID=your_numeric_x_user_id

# LinkedIn, Pinterest, Snapchat, Threads, Reddit and Bluesky have no provider yet;
# they appear as "Not connected" until one is added in /server/providers.
